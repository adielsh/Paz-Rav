# Copy this file to  .env  and fill in your IBKR PAPER (demo) credentials.
#   cp .env.example .env
# The .env file holds secrets — it is git-ignored. Never commit it.

# Your PAPER account username/password (the paper login, NOT your live login).
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password

# Optional: set a VNC password if you want to watch the gateway UI on :5900.
VNC_SERVER_PASSWORD=

# IBKR Flex Web Service — REAL account statement data (trades + NAV) for the performance views.
# Account Management → Reporting → Settings → Flex Web Service: enable + generate a token.
# Account Management → Reporting → Flex Queries → new Activity query with "Trades" + "Change in NAV",
# period "Last 365 Calendar Days". Copy its Query ID.
FLEX_TOKEN=
FLEX_QUERY_ID=

# ---- Order safety -------------------------------------------------------------------------
# Master switch. 0 = dry-run: gates are evaluated and persisted, no order ever reaches IBKR.
PLACE_ORDERS=0

# Human in the loop. 1 = a condor that passes every gate is parked in the UI ("Entry approvals")
# and waits for you to approve it; on approval the bot re-prices and re-validates before sending.
# 0 = fully automatic entry. Both this AND PLACE_ORDERS=1 are required to trade unattended.
REQUIRE_APPROVAL=1

# How long a pending proposal stays actionable before it self-expires (minutes).
PROPOSAL_TTL_MINUTES=120

# ---- App auth (multi-user) --------------------------------------------------------------
# REQUIRED. Signs sessions AND encrypts every user's stored broker credentials.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it logs everyone out and makes stored credentials unreadable.
APP_SECRET_KEY=

# ---- In-console assistant -----------------------------------------------------------------
# Answers questions about the data on screen. It is handed an already-computed snapshot and is
# instructed never to produce a number that is not in it. Leave blank to disable the widget.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only for an identity-linked key ("anthropic-workspace-id is required..." on every call).
# Console -> Settings -> Workspaces; the id looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=
CHAT_MODEL=claude-opus-5
# Thinking depth: low is right for looking a figure up in a snapshot. Raise only if
# answers start missing things.
CHAT_EFFORT=low

# Where the console is served. Only used to build the password-reset link, which this
# deployment writes to the API log (there is no mail server):
#   docker compose logs api | grep "PASSWORD RESET LINK"
CONSOLE_URL=http://127.0.0.1:8080
# How long a reset link stays usable. It is single-use regardless.
RESET_TTL_MINUTES=30

# 1 = anyone can create an account. 0 = closed (the first account can always be created).
ALLOW_SIGNUP=1
SESSION_HOURS=12
# Set to 1 once you serve the console over HTTPS.
COOKIE_SECURE=0

# ============================================================================
# THE ENGINE  (src/paz_rav/ — the multi-underlying strategy engine on :8010)
# ============================================================================
# Advisory only: it has no broker connection and no route that places an order.
# Its own Firebase auth gate stays off, because the console's API proxies it behind
# your session — so ALLOWED_EMAIL / FIREBASE_PROJECT_ID are deliberately left unset.

# Market data for the engine. `yfinance` = free, ~15-min delayed, real chains.
# `fixture` = the offline sample chain in tests/fixtures (deterministic, no network).
# The engine does NOT yet read the IB gateway — adapters/ibkr.py is still a stub — so
# this is delayed data, and the console's Strategy ideas page says so on every scan.
PAZ_DATA=yfinance

# Which names the engine scans. Separate from the daemon, which trades SPX only.
UNDERLYINGS=SPX,SPY,QQQ,IWM,NVDA,MSFT,GOOGL,AMZN,CSCO

# LLM tracing for the engine's AI layer. Blank = tracing silently no-ops.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# NOTE: ANTHROPIC_API_KEY above is shared — it powers both the console's in-page
# assistant and the engine's close-timing debate (the `advisor` service).

# ---- Only needed when running the engine from source, outside compose ----------------
# docker-compose.yml sets all of these itself; they are here for `uvicorn paz_rav...`.
# Storage: "memory" (nothing survives a restart) or "redis_postgres" (real persistence).
# PAZ_PERSIST=memory
# DATABASE_URL=postgresql://paz:paz@localhost:5432/condor
# REDIS_URL=redis://localhost:6379/0
# ADVISOR_URL=http://localhost:8001
# PAZ_ENV=local
# LOG_LEVEL=INFO
# Max concurrent LLM agent calls.
# AGENT_CONCURRENCY=4

# ---- Firebase sign-in for the engine's OWN dashboard on :8010 ------------------------
# Empty ALLOWED_EMAIL = auth OFF, which is what the merged stack expects: :8010 binds to
# localhost only and the console reaches the engine through its authenticated proxy.
# Set both only if you expose :8010 publicly.
# FIREBASE_PROJECT_ID=
# ALLOWED_EMAIL=
