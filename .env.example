# Copy this file to  .env  and fill in your IBKR PAPER (demo) credentials.
#   cp .env.example .env
# The .env file holds secrets — it is git-ignored. Never commit it.

# Your PAPER account username/password (the paper login, NOT your live login).
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password

# Optional: set a VNC password if you want to watch the gateway UI on :5900.
VNC_SERVER_PASSWORD=

# IBKR Flex Web Service — REAL account statement data (trades + NAV) for the performance views.
# Account Management → Reporting → Settings → Flex Web Service: enable + generate a token.
# Account Management → Reporting → Flex Queries → new Activity query with "Trades" + "Change in NAV",
# period "Last 365 Calendar Days". Copy its Query ID.
FLEX_TOKEN=
FLEX_QUERY_ID=

# ---- Order safety -------------------------------------------------------------------------
# Master switch. 0 = dry-run: gates are evaluated and persisted, no order ever reaches IBKR.
PLACE_ORDERS=0

# Human in the loop. 1 = a condor that passes every gate is parked in the UI ("Entry approvals")
# and waits for you to approve it; on approval the bot re-prices and re-validates before sending.
# 0 = fully automatic entry. Both this AND PLACE_ORDERS=1 are required to trade unattended.
REQUIRE_APPROVAL=1

# How long a pending proposal stays actionable before it self-expires (minutes).
PROPOSAL_TTL_MINUTES=120
